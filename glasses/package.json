{
  "name": "breakpoint-glasses",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pack": "vite build && bun scripts/manifest.ts && evenhub pack build/app.json dist -o breakpoint.ehpk",
    "simulate": "evenhub-simulator http://localhost:5180 --automation-port 9898"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.2.0",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
